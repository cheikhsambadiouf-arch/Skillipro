# Clé de chiffrement des sessions (cookie de connexion). Obligatoire en production,
# doit faire au moins 32 caractères. Générer par ex. avec : openssl rand -hex 32
SESSION_SECRET=

# Emplacement du fichier SQLite (node:sqlite). Par défaut ./data/skillia.db.
# Sur un hébergeur comme Render, pointer vers un disque persistant si disponible,
# sinon les comptes créés seront perdus à chaque redéploiement.
DATABASE_PATH=./data/skillia.db
